{
  "name": "dsh-quick-invoke",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "commandUi",
        "connection",
        "sessions",
        "remote"
      ]
    }
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/client.js",
    "./typert": "./src/project-agent-presets-remote.js",
    "./remote": "./client/project-agent-presets-remote.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test --test-isolation=none test/**/*.test.js",
    "test:parser": "node --test --test-isolation=none test/parser.test.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-presets": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-apiproxy": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-plugin-inventory": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-input-trigger": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2"
  }
}
